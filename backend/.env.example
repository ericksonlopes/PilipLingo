# Copie para .env e ajuste. Todas as variaveis usam o prefixo PILIPLINGO_.

PILIPLINGO_ENVIRONMENT=local
PILIPLINGO_DEBUG=true

# SQLite local (padrao). O arquivo fica em backend/data/piliplingo.db.
PILIPLINGO_DATABASE_URL=sqlite+aiosqlite:///./data/piliplingo.db
PILIPLINGO_DATABASE_ECHO=false

PILIPLINGO_API_PREFIX=/api/v1
PILIPLINGO_PORT=8000

# Origens liberadas no CORS (separadas por virgula ou lista JSON).
# Para testar no celular, inclua o IP da sua maquina: http://192.168.0.10:5173
PILIPLINGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Geracao de frases com IA (LangChain + Gemini) ----
# Chave da Gemini Developer API: https://aistudio.google.com/apikey
# Vazia = /vocabulary/sentences/generate responde 503 e o app esconde a feature.
PILIPLINGO_GOOGLE_API_KEY=

# Flash GA: gemini-2.0-flash (equilibrado) | gemini-2.0-flash-lite (mais barato)
PILIPLINGO_GEMINI_MODEL=gemini-2.0-flash
PILIPLINGO_GEMINI_TEMPERATURE=0.7
PILIPLINGO_GEMINI_TIMEOUT_SECONDS=25
PILIPLINGO_GEMINI_MAX_RETRIES=2

# Teto de frases por chamada (cada chamada custa tokens).
PILIPLINGO_SENTENCES_MAX_PER_REQUEST=5

# ---- Autenticacao (login usuario + senha, token JWT) ----
# TROQUE em producao. Use >= 32 bytes (ex.: `openssl rand -hex 32`).
PILIPLINGO_JWT_SECRET=dev-only-change-me-please-32bytes-minimum
PILIPLINGO_JWT_ALGORITHM=HS256
# Validade do token em minutos (padrao: 7 dias).
PILIPLINGO_JWT_EXPIRE_MINUTES=10080
