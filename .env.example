# Copie para .env na raiz: o docker compose le este arquivo automaticamente.
# NAO versione o .env (ja esta no .gitignore).

# Chave da Gemini Developer API (https://aistudio.google.com/apikey).
# Sem ela o backend responde 503 em /vocabulary/sentences/generate e /chat/conversations/{id}/turns.
PILIPLINGO_GOOGLE_API_KEY=

# Modelos Flash GA: gemini-3.5-flash (equilibrado) | gemini-3.5-flash-lite (mais barato)
PILIPLINGO_GEMINI_MODEL=gemini-3.5-flash

# ---- Chat IA ----
PILIPLINGO_CHAT_AI_MODEL=gemini-1.5-flash
PILIPLINGO_CHAT_AI_TIMEOUT=30
PILIPLINGO_CHAT_MAX_TURN_LIMIT=40
